# Client address for rate limiting. $remote_addr is the proxy in production, so when the request
# came from the trusted proxy the last X-Forwarded-For entry (the one the proxy added) is used
# instead. REMOTE_ADDR for PHP is left alone: Laravel's TrustProxies needs the proxy's address.
geo $from_proxy {
    default 0;
    ${REAL_IP_FROM} 1;
}

map "$from_proxy:$http_x_forwarded_for" $limit_key {
    default $remote_addr;
    "~^1:(?:.*[,\s])?(?<client>[^,\s]+)\s*$" $client;
}

# Bodies of up to 50 MB are accepted on the upload paths before the app can check who is
# sending them, so each client address gets a small request budget there. POSTs only: an empty
# key is not limited, so viewing GET /uploads doesn't spend the upload budget.
map $request_method $upload_limit_key {
    POST $limit_key;
    default "";
}

limit_req_zone $upload_limit_key zone=uploads:10m rate=30r/m;
limit_req_status 429;

server {
    listen 80;
    index index.php;
    server_name _;
    server_tokens off;
    root /var/www/html/public;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Small by default; only the two upload paths below get a bigger cap.
    client_max_body_size 2m;

    # Re-resolve `app` per request (via $upstream_app) so nginx follows the container to its
    # new IP when `app` is recreated on deploy, instead of holding a stale one until restart.
    resolver 127.0.0.11 valid=10s;

    # Uploader endpoint and manual upload page (POST /api/v1/ingest, POST /uploads). Must match
    # the route paths and ledger.ingest.max_request_bytes. It fastcgi_passes straight to
    # index.php because client_max_body_size follows the final location, not the original URI.
    location ~ ^/(api/v1/ingest|uploads)$ {
        client_max_body_size 50m;
        limit_req zone=uploads burst=10 nodelay;
        fastcgi_read_timeout 120s;
        set $upstream_app app:9000;
        fastcgi_pass $upstream_app;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
    }

    # Admin "Fetch now" (POST /admin/fetch) runs a whole price fetch in the request; must match
    # the route path and AdminController::fetchNow's time limit.
    location = /admin/fetch {
        fastcgi_read_timeout 310s;
        set $upstream_app app:9000;
        fastcgi_pass $upstream_app;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
    }

    # Vite build output has content-hashed names, so it can be cached for good. Served here
    # without PHP; the app's security headers do not apply, so the one that matters is set.
    location ^~ /build/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Before the PHP location: regex locations match in order, so /.git/x.php is denied here.
    location ~ /\.(?!well-known).* {
        deny all;
    }

    location ~ \.php$ {
        # Only scripts that exist in public/ reach php-fpm.
        try_files $uri =404;
        set $upstream_app app:9000;
        fastcgi_pass $upstream_app;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
    }
}
