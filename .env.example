# Copy to .env, or run scripts/setup.sh, which does that and fills the blank secrets.
# These defaults are for local use at http://localhost:8087. Production overrides (README, "Deploy"):
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_DOMAIN=wowledger.joshespi.com
#   APP_URL=https://${APP_DOMAIN}
#   APP_BIND=127.0.0.1                 # when the TLS proxy runs on this host
#   TRUSTED_PROXIES=<IP/CIDR of the reverse proxy as nginx sees it>
#   LEDGER_FORCE_HTTPS=true            # only once TRUSTED_PROXIES is right (see README)
#   SESSION_SECURE_COOKIE=true
#   LOG_LEVEL=warning
#   MAIL_MAILER=smtp  + the Brevo MAIL_* values below
#   BLIZZARD_CLIENT_ID / BLIZZARD_CLIENT_SECRET
#   LEDGER_CONTACT_EMAIL=<address shown on the privacy page>
#   LEDGER_VERSION=<release shown in the footer, e.g. 1.0.0>
APP_NAME="WoW Flip Ledger"
APP_ENV=local
APP_KEY=
APP_DEBUG=false

# Host port nginx is published on (docker-compose.yml).
APP_PORT=8087

APP_DOMAIN=localhost:${APP_PORT}
APP_URL=http://${APP_DOMAIN}

# nginx only speaks plain HTTP. Behind a TLS-terminating proxy, set this to the proxy's
# IP/CIDR so Laravel sees the original scheme and client IP. Never `*`: that lets any
# client forge X-Forwarded-For and dodge the per-IP login throttle.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=wow_flip_ledger
DB_USERNAME=wow_flip_ledger
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync on purpose: there is no queue worker service. Don't add ShouldQueue jobs without one.
QUEUE_CONNECTION=sync
CACHE_STORE=database

# "log" writes mail to the container log instead of sending it. Switch to smtp (Brevo) before
# real signups. MAIL_FROM_ADDRESS must be a sender verified in Brevo for this domain.
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@wowledger.joshespi.com"
MAIL_FROM_NAME="${APP_NAME}"

# Blizzard Game Data API for commodity prices. Create a client at the Blizzard developer portal
# (develop.battle.net), then check it with: docker compose exec app php artisan prices:probe
# Price jobs stay idle until both are set. Optional overrides: BLIZZARD_TOKEN_URL, BLIZZARD_API_URL.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=us

# Local test login created by `php artisan db:seed`. Skipped when APP_ENV=production.
# Local-only values; change them if the app is reachable from outside this machine.
SEED_USER_EMAIL=test@example.com
SEED_USER_PASSWORD=password

VITE_APP_NAME="${APP_NAME}"

# Shown on About, Privacy and Terms when set
LEDGER_CONTACT_EMAIL=

# Footer: app version ("dev" when unset) and the issue tracker link
LEDGER_VERSION=
LEDGER_ISSUES_URL=https://github.com/joshespi/WoW-AH-Flip-Ledger/issues

# Bind address for nginx's published port. Loopback by default (a proxy on the same host, or local use);
# set 0.0.0.0 only to reach it from another machine or a proxy on another host.
APP_BIND=127.0.0.1

# Redirect plain HTTP to APP_URL (must be https). Leave false until TRUSTED_PROXIES is set, or a
# proxy that Laravel does not trust makes every request look like HTTP and it redirects forever.
LEDGER_FORCE_HTTPS=false

# Daily database dump into ./backups (the `backup` service): how many days to keep and when (UTC).
BACKUP_KEEP_DAYS=14
BACKUP_HOUR_UTC=3
